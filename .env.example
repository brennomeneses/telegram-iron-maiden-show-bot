# Copie este arquivo para .env e preencha os valores

# Token do seu bot no Telegram (obtenha com o @BotFather)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Intervalo entre verificações em segundos (padrão: 300 = 5 minutos)
# Recomendado: mínimo 120s para não sobrecarregar os sites
CHECK_INTERVAL_SECONDS=300
